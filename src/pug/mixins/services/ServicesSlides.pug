mixin Slide(config)
  .swiper-slide
    .row.align-items-xl-center
      .col-lg-5
        img(src=`${CWD}assets/img/exhibitions/${config.image}` alt="").img-fluid.w-100
        .position-absolute.top-5.start-5.mt-n1.d-flex.flex-column.align-items-center
          span.rounded-circle.bg-white.p-2.d-block
          span.text-white.fw-bold=config.year
      .col-lg-6.col-xl-5.mt-4.mt-lg-0
        h1.fw-bolder.mb-3=config.title
        p.text-warning.fs-3.opacity-75=config.type
        p.fs-0=config.desc
        button.btn.btn-link.text-warning.p-0.fs-2
          span.fw-bolder Details 
          img(src=`${CWD}assets/img/icons/long-arrow.png` alt="").ms-3


mixin ServicesSlides 
  +Section('container-fluid px-0').py-3.position-relative
    .position-absolute.w-100.border-dashed-bottom.opacity-25.top-5.z-index-2
    .container.px-md-5
      .row.g-0
        .col-lg-12.pb-6.px-0.mb-lg-0
          .swiper-container.swiper-theme(data-swiper!={
            slidesPerView: 1,
            breakpoints: {
              576: {
                slidesPerView: 1.2,
              },
            },
            spaceBetween: 30,
            grabCursor: true,
            pagination: {
              el: '.swiper-pagination',
              clickable: true,
            },
            loop: true,
            loopedSlides: 3,
            slideToClickedSlide: true,
            autoplay: {
              delay: 2000,
              disableOnInteraction: false,
            },
            keyboard: {
              enabled: true,
            },
          })
            .swiper-wrapper
              each exhibition in services
                +Slide(exhibition)
          .swiper-theme.swiper-pagination.d-flex.mt-4
