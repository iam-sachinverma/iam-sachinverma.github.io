mixin Slide(config)
  .swiper-slide
    .row.align-items-center
      .col-xl-7
        .position-relative 
          .position-absolute.start-0.bottom-0.ms-3
            h3.text-white #{config.title}
            p.text-300 #{config.subtitle}
          img.portfolio-img(src=`${CWD}assets/img/portfolio/${config.image}` alt="").img-fluid
      .col-xl-4.mt-4
        p.fs-0=config.description

mixin PortfolioSlides 
  +Section('container-fluid px-0').py-3
    .position-absolute.w-100.border-dashed-bottom.opacity-25.top-5.z-index-1
    .container.px-md-5
      .row.g-0
        .col-lg-12.pb-6.px-0.mb-lg-0
          .swiper-container.swiper-theme(data-swiper!={
            slidesPerView: 1,
            breakpoints: {
              576: {
                slidesPerView: 1.2,
              },
            },
            spaceBetween: 30,
            grabCursor: true,
            pagination: {
              el: '.swiper-pagination',
              clickable: true,
            },
            loop: true,
            loopedSlides: 3,
            slideToClickedSlide: true,
            autoplay: {
              delay: 2000,
              disableOnInteraction: false,
            },
            keyboard: {
              enabled: true,
            },
          })
            .swiper-wrapper
              +Slide({title: "Ztelier", subtitle: "ZTELIER - Branding | Advertising | Content Creation Advertising Agency | United Arab Emirates | Europe", description: "Revamped our website into a stunning, responsive masterpiece! Zetlier's creative vision combined with your design and development expertise has significantly boosted our online presence and performance. Highly recommend! - Sarah S., Creative Director, Zetlier.", image: 'img01.png'})
              +Slide({title: "ASC360", subtitle: "Adventure Sports Cover", description: "Their team developed an intuitive and user-friendly mobile app for our business. The project was delivered on time, and the app's performance exceeded our expectations. We've received excellent feedback from our users.", image: 'img02.png'})
              +Slide({title: "EcoFreaky", subtitle: "EcoFriendly Ecommerce", description: "They helped me transform my YouTube channel Anuj Ramatri to an eco-friendly brand EcoFreaky, a thriving e-commerce business. Their WordPress website is not only visually stunning but also SEO optimized, helping us rank higher on Google and sales platforms Flipkart. We've seen a significant boost in sales since partnering with them.", image: 'img03.png'})  
          .swiper-theme.swiper-pagination.d-flex.mt-4
